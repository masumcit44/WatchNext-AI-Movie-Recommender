# Frontend uses this URL to call the backend.
BACKEND_URL=http://127.0.0.1:8000

# CORS allowed origins for the backend (comma-separated).
# Default: http://localhost:8501,http://127.0.0.1:8501
# Never use "*" with credentials.
CORS_ALLOW_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Optional: path to the dataset; ML developer may read this setting.
# MOVIES_CSV=data/tmdb_5000_movies.csv
# CREDITS_CSV=data/tmdb_5000_credits.csv